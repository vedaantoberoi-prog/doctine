# Copy to .env.local for `npm run dev` (never commit .env.local). Use development or staging values only:
# never production keys, and never real patient data.
DOCTINE_ENV=development
ANTHROPIC_API_KEY=
# Leave the Supabase values empty to use browser-only demo accounts, or use a personal development project.
# The service-role key bypasses row-level security: only ever a development project's key here, never staging's or
# production's. Never print it, paste it into chat, or commit this file once filled in (.env.local is git-ignored).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SECRET=
