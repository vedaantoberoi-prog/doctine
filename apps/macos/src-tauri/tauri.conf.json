{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doctine",
  "version": "1.0.0",
  "identifier": "com.doctine.app",
  "build": { "frontendDist": "../www" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Doctine",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Medical",
    "shortDescription": "Your personal health records",
    "longDescription": "Doctine keeps your medical records, reports, prescriptions and medicine schedules in your own private account, the same one you use at app.doctine.com. Doctine is not a doctor or an emergency service.",
    "copyright": "© 2026 Doctine",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["doctine"] } }
  }
}
