# Runs Doctine's medical evaluation once against staging (synthetic cases; spends a little AI credit per run).
# Install: sudo cp infra/oracle-a1/doctine-eval.{service,timer} /etc/systemd/system/ && sudo systemctl daemon-reload
# Run now:  sudo systemctl start doctine-eval    Log: journalctl -u doctine-eval
[Unit]
Description=Doctine medical evaluation against staging
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/doctine/infra/oracle-a1
ExecStart=/usr/bin/docker compose run --rm evaluator
TimeoutStartSec=3600
