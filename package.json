{
  "name": "doctine",
  "private": true,
  "description": "Doctine: personal health records and health assistant (Netlify site + functions, Supabase).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "check": "node tools/check-syntax.mjs && node tools/check-config.mjs && node tools/scan-secrets.mjs",
    "test:server": "node tests/functions.test.mjs && node tests/admin-api.test.mjs",
    "test:db": "bash tests/run-db-tests.sh",
    "test:browser": "node tools/run-browser-tests.mjs",
    "test": "npm run check && npm run test:server && npm run eval:grader && npm run test:gates && npm run test:tools",
    "eval:live": "node tests/live-eval.mjs",
    "eval:grader": "node tests/eval-grader.test.mjs",
    "sync:safety": "node tools/sync-safety-rules.mjs",
    "report": "node tools/release-report.mjs",
    "build:check": "esbuild netlify/functions/*.mjs --bundle --platform=node --format=esm --target=node20 --outdir=.build-check --log-level=warning",
    "smoke": "node tools/smoke-check.mjs",
    "build:preview": "node tools/build-preview.mjs",
    "build:direct": "node tools/build-direct.mjs",
    "test:gates": "node tests/release-gates.test.mjs",
    "test:tools": "node tests/netlify-guard.test.mjs && node tests/cloudflare-adapter.test.mjs",
    "build:website": "node tools/build-website.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
